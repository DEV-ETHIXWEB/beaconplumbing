---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SEOHead from '../../components/SEOHead.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import ServiceIcon from '../../components/ui/ServiceIcon.astro';
import { serviceCategories, getServicesByCategory } from '../../data/services';
import drainImg from '../../assets/photos/service-drain-cleaning.webp';
import waterHeaterImg from '../../assets/photos/service-water-heaters.webp';
import hvacImg from '../../assets/photos/service-furnaces-hvac.webp';

const images: Record<string, ImageMetadata> = {
  'sewer-drain': drainImg,
  plumbing: waterHeaterImg,
  'heating-hvac': hvacImg,
};
---

<Layout>
  <Fragment slot="head">
    <SEOHead
      title="Plumbing, Heating & Electrical Services | Beacon Plumbing Seattle"
      description="Explore Beacon Plumbing's full range of services: plumbing, sewer & drain, heating & HVAC, air conditioning, electrical, and septic — serving the greater Seattle area."
      path="/services"
    />
  </Fragment>

  <PageHero
    eyebrow="Our Services"
    title="Full-Service Plumbing, Heating & Electrical"
    description="One trusted team for every trade in your home — licensed, bonded, and available 24/7 for emergencies."
    breadcrumbs={[{ name: 'Services', url: '/services' }]}
  />

  <section class="bg-white py-16 sm:py-20">
    <Container class="flex flex-col gap-16">
      {serviceCategories.map((category) => {
        const categoryServices = getServicesByCategory(category.slug);
        const image = images[category.slug];
        return (
          <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
            <div class={`relative h-56 overflow-hidden rounded-xl sm:h-72 ${image ? '' : 'bg-gradient-to-br from-brand-600 via-brand-700 to-brand-900'}`}>
              {image ? (
                <Image src={image} alt={`${category.name} services`} class="h-full w-full object-cover" />
              ) : (
                <div class="relative flex h-full flex-col items-center justify-center gap-4 p-6 text-center">
                  <div class="pointer-events-none absolute inset-0 opacity-[0.08]" aria-hidden="true">
                    <svg width="100%" height="100%">
                      <pattern id={`pattern-${category.slug}`} width="28" height="28" patternUnits="userSpaceOnUse">
                        <circle cx="2" cy="2" r="1.5" fill="white" />
                      </pattern>
                      <rect width="100%" height="100%" fill={`url(#pattern-${category.slug})`} />
                    </svg>
                  </div>
                  <div class="relative flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 text-gold-500 ring-1 ring-white/20">
                    <ServiceIcon icon={category.icon} class="h-8 w-8" />
                  </div>
                  <span class="relative font-display text-2xl font-bold text-white">{category.name}</span>
                </div>
              )}
            </div>
            <div>
              <h2 class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">{category.name}</h2>
              <p class="mt-2 max-w-xl text-ink-500">{category.description}</p>
              <ul class="mt-5 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
                {categoryServices.map((service) => (
                  <li>
                    <a
                      href={`/services/${category.slug}/${service.slug}`}
                      class="group flex items-center gap-2 text-sm font-medium text-ink-700 hover:text-brand-600"
                    >
                      <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0 text-brand-400 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {service.name}
                    </a>
                  </li>
                ))}
              </ul>
              <a href={`/services/${category.slug}`} class="mt-5 inline-flex items-center gap-1.5 font-display text-sm font-semibold text-brand-600 hover:text-brand-700">
                View all {category.name} services
                <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </Container>
  </section>
</Layout>
