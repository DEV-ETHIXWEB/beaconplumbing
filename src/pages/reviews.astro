---
import Layout from '../layouts/Layout.astro';
import SEOHead from '../components/SEOHead.astro';
import PageHero from '../components/sections/PageHero.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { testimonials } from '../data/testimonials';
import { business } from '../data/business';

function Stars() {
  return Array.from({ length: 5 });
}
---

<Layout>
  <Fragment slot="head">
    <SEOHead
      title="Customer Reviews | Beacon Plumbing Seattle"
      description="Read real customer reviews for Beacon Plumbing's plumbing, heating, electrical, and septic service across the greater Seattle area."
      path="/reviews"
    />
  </Fragment>

  <PageHero
    eyebrow="Customer Reviews"
    title="What Our Customers Say"
    description="Real feedback from real Beacon Plumbing customers across Puget Sound."
    breadcrumbs={[{ name: 'Reviews', url: '/reviews' }]}
  />

  <section class="bg-white py-16 sm:py-20">
    <Container>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {testimonials.map((review) => (
          <figure class="flex flex-col gap-4 rounded-xl border border-ink-100 bg-white p-6 shadow-sm">
            <div class="flex gap-0.5 text-gold-500" aria-label={`${review.rating} out of 5 stars`}>
              {Stars().map(() => (
                <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                  <path d="M10 1.5l2.6 5.3 5.9.85-4.25 4.15 1 5.85L10 14.9l-5.25 2.75 1-5.85L1.5 7.65l5.9-.85z" />
                </svg>
              ))}
            </div>
            <blockquote class="text-sm leading-relaxed text-ink-600">&ldquo;{review.quote}&rdquo;</blockquote>
            <figcaption class="mt-auto text-sm font-semibold text-ink-900">{review.name}</figcaption>
          </figure>
        ))}
      </div>

      <div class="mt-12 flex flex-col items-center gap-4 rounded-2xl bg-brand-950 p-8 text-center text-white sm:p-10">
        <h2 class="font-display text-2xl font-bold text-white">See more verified reviews</h2>
        <p class="max-w-lg text-brand-100">
          Beacon Plumbing's full review history is available on our Google Business Profile and BBB listing.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <Button href={business.bbb.profileUrl} variant="outline" size="md" class="border-white text-white hover:bg-white/10 hover:text-white">
            View BBB Profile
          </Button>
        </div>
      </div>
    </Container>
  </section>
</Layout>
