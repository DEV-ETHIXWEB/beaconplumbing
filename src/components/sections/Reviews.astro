---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { testimonials } from '../../data/testimonials';
import { business } from '../../data/business';

function Stars() {
  return Array.from({ length: 5 });
}
---

<section class="bg-white py-16 sm:py-24">
  <Container>
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <SectionHeading
        eyebrow="Customer Reviews"
        title="What our customers are saying"
        description="Real reviews from real Beacon customers across the Puget Sound area."
      />
      <a
        href="/reviews"
        class="hidden shrink-0 items-center gap-1.5 font-display text-sm font-semibold text-brand-600 hover:text-brand-700 sm:inline-flex"
      >
        Read all reviews
        <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((review) => (
        <figure class="flex flex-col gap-4 rounded-xl border border-ink-100 bg-white p-6 shadow-sm">
          <div class="flex gap-0.5 text-gold-500" aria-label={`${review.rating} out of 5 stars`}>
            {Stars().map(() => (
              <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                <path d="M10 1.5l2.6 5.3 5.9.85-4.25 4.15 1 5.85L10 14.9l-5.25 2.75 1-5.85L1.5 7.65l5.9-.85z" />
              </svg>
            ))}
          </div>
          <blockquote class="text-sm leading-relaxed text-ink-600">&ldquo;{review.quote}&rdquo;</blockquote>
          <figcaption class="mt-auto text-sm font-semibold text-ink-900">{review.name}</figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-center gap-4 rounded-xl bg-ink-50 p-6 text-center sm:flex-row sm:justify-between sm:text-left">
      <p class="text-sm text-ink-500">
        See more verified reviews on our Google Business Profile and BBB listing.
      </p>
      <div class="flex gap-3">
        <Button href={business.bbb.profileUrl} variant="outline" size="md">View BBB Profile</Button>
      </div>
    </div>
  </Container>
</section>
