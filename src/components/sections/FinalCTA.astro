---
import { business } from '../../data/business';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-600 to-brand-900 py-16 sm:py-20">
  <div class="pointer-events-none absolute -left-20 top-0 h-72 w-72 rounded-full bg-white/5 blur-3xl" aria-hidden="true"></div>
  <Container class="relative flex flex-col items-center gap-6 text-center">
    <h2 class="max-w-2xl font-display text-3xl font-bold text-white sm:text-4xl">
      {business.tagline}
    </h2>
    <p class="max-w-xl text-brand-100">
      Whether it&rsquo;s a slow drain or a full system replacement, Beacon Plumbing is ready when you are.
    </p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <Button href={business.phone.href} variant="primary" size="lg" icon="phone">
        Call {business.phone.display}
      </Button>
      <Button href="/contact" variant="outline" size="lg" class="border-white text-white hover:bg-white/10 hover:text-white">
        Request Service Online
      </Button>
    </div>
  </Container>
</section>
