---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { serviceAreas, regions } from '../../data/locations';
---

<section class="bg-brand-950 py-16 text-white sm:py-24">
  <Container>
    <SectionHeading
      eyebrow="Where We Work"
      title="Serving the Greater Puget Sound Region"
      description="From Seattle to Tacoma, Everett to Bremerton — Beacon dispatches licensed technicians across dozens of communities."
      titleClass="text-white"
      class="[&_p]:text-brand-200"
    />

    <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-5">
      {regions.map((region) => (
        <div>
          <h3 class="mb-3 text-xs font-bold uppercase tracking-widest text-gold-500">{region}</h3>
          <ul class="flex flex-col gap-2 text-sm text-brand-100">
            {serviceAreas
              .filter((a) => a.region === region)
              .slice(0, 6)
              .map((area) => (
                <li>
                  <a href={`/service-areas/${area.slug}`} class="hover:text-white">{area.name}</a>
                </li>
              ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 flex justify-center">
      <Button href="/service-areas" variant="outline" size="lg" class="border-white text-white hover:bg-white/10 hover:text-white">
        View All {serviceAreas.length}+ Service Areas
      </Button>
    </div>
  </Container>
</section>
