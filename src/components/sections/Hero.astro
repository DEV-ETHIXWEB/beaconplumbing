---
import { Image } from 'astro:assets';
import truckPhoto from '../../assets/photos/hero-truck-pike-place.webp';
import { business } from '../../data/business';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-900 via-brand-800 to-brand-950 py-16 sm:py-20 lg:py-28">
  <div class="pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true">
    <svg width="100%" height="100%">
      <pattern id="hero-grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M40 0H0V40" fill="none" stroke="white" stroke-width="1" />
      </pattern>
      <rect width="100%" height="100%" fill="url(#hero-grid)" />
    </svg>
  </div>
  <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-brand-400/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-24 left-1/3 h-72 w-72 rounded-full bg-accent-500/10 blur-3xl" aria-hidden="true"></div>

  <Container class="relative grid grid-cols-1 items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-8">
    <div class="flex flex-col items-start gap-6 animate-fade-up">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-white ring-1 ring-white/20 backdrop-blur">
        <span class="h-1.5 w-1.5 rounded-full bg-gold-500"></span>
        Serving Puget Sound Since {business.foundingYear}
      </span>

      <h1 class="max-w-xl text-4xl font-extrabold leading-[1.08] text-white sm:text-5xl lg:text-6xl">
        Seattle&rsquo;s Plumber, Electrician &amp; HVAC Team &mdash;
        <span class="text-gold-500">On Call 24/7</span>
      </h1>

      <p class="max-w-lg text-lg leading-relaxed text-brand-100">
        {business.tagline} Licensed, bonded, and insured plumbing, heating, electrical, and septic
        service across the greater Seattle area &mdash; day or night.
      </p>

      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <Button href={business.phone.href} variant="primary" size="lg" icon="phone">
          Call {business.phone.display}
        </Button>
        <Button href="/contact" variant="outline" size="lg" class="border-white text-white hover:bg-white/10 hover:text-white">
          Request Service
        </Button>
      </div>

      <div class="mt-2 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-brand-100">
        {business.trustBadges.map((badge) => (
          <span class="inline-flex items-center gap-1.5">
            <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0 text-gold-500" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4L8 11.6l6.8-6.8a1 1 0 0 1 1.4 0z" clip-rule="evenodd" />
            </svg>
            {badge.label}
          </span>
        ))}
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-md animate-fade-up [animation-delay:150ms]">
      <div class="absolute -inset-4 rounded-2xl bg-gradient-to-br from-gold-500/30 to-accent-500/20 blur-2xl" aria-hidden="true"></div>
      <figure class="relative overflow-hidden rounded-2xl border-4 border-white/10 bg-brand-950 shadow-2xl">
        <Image
          src={truckPhoto}
          alt="Beacon Plumbing service truck parked near Pike Place Market in Seattle"
          width={500}
          height={279}
          class="h-auto w-full"
          priority
        />
        <figcaption class="border-t border-white/10 bg-brand-950/90 px-4 py-2.5 text-xs text-brand-200">
          A Beacon Plumbing truck on call in downtown Seattle
        </figcaption>
      </figure>

      <div class="absolute -top-5 -right-5 hidden rounded-xl bg-white px-5 py-4 shadow-xl sm:block">
        <p class="font-display text-2xl font-extrabold text-brand-600">24/7</p>
        <p class="text-xs font-medium text-ink-500">Emergency Response</p>
      </div>
    </div>
  </Container>
</section>
