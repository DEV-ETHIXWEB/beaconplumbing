---
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ServiceIcon from '../ui/ServiceIcon.astro';
import { serviceCategories } from '../../data/services';
import drainImg from '../../assets/photos/service-drain-cleaning.webp';
import waterHeaterImg from '../../assets/photos/service-water-heaters.webp';
import hvacImg from '../../assets/photos/service-furnaces-hvac.webp';

const images: Record<string, ImageMetadata> = {
  'sewer-drain': drainImg,
  plumbing: waterHeaterImg,
  'heating-hvac': hvacImg,
};
---

<section class="bg-white py-16 sm:py-24">
  <Container>
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <SectionHeading
        eyebrow="What We Do"
        title="Full-Service Plumbing, Heating & Electrical"
        description="One trusted team for every trade in your home — from a dripping faucet to a full furnace replacement."
      />
      <a href="/services" class="hidden shrink-0 items-center gap-1.5 font-display text-sm font-semibold text-brand-600 hover:text-brand-700 sm:inline-flex">
        View all services
        <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {serviceCategories.map((category, index) => {
        const image = images[category.slug];
        const isFeatured = index === 0;
        return (
          <a
            href={`/services/${category.slug}`}
            class={`group relative flex flex-col overflow-hidden rounded-xl border border-ink-100 bg-white shadow-sm transition-all duration-300 hover:shadow-lg ${
              isFeatured ? 'sm:col-span-2 sm:row-span-2' : ''
            }`}
          >
            {image ? (
              <div class={`relative overflow-hidden ${isFeatured ? 'h-56 sm:h-72' : 'h-40'}`}>
                <Image
                  src={image}
                  alt={`${category.name} service by Beacon Plumbing`}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
            ) : (
              <div class="relative flex h-40 items-center gap-4 overflow-hidden bg-gradient-to-br from-brand-600 via-brand-700 to-brand-900 px-6">
                <div class="pointer-events-none absolute inset-0 opacity-[0.08]" aria-hidden="true">
                  <svg width="100%" height="100%">
                    <pattern id={`pattern-home-${category.slug}`} width="24" height="24" patternUnits="userSpaceOnUse">
                      <circle cx="2" cy="2" r="1.5" fill="white" />
                    </pattern>
                    <rect width="100%" height="100%" fill={`url(#pattern-home-${category.slug})`} />
                  </svg>
                </div>
                <div class="relative flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/10 text-gold-500 ring-1 ring-white/20">
                  <ServiceIcon icon={category.icon} class="h-6 w-6" />
                </div>
                <span class="relative font-display text-xl font-bold text-white">{category.name}</span>
              </div>
            )}

            <div class="flex flex-1 flex-col gap-1.5 p-6">
              <h3 class="font-display text-xl font-bold text-ink-900 sm:text-2xl">{category.name}</h3>
              <p class="max-w-sm text-sm text-ink-500">{category.description}</p>
              <span class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
                Explore services
                <svg viewBox="0 0 20 20" class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>

    <a href="/services" class="mt-8 flex items-center justify-center gap-1.5 font-display text-sm font-semibold text-brand-600 sm:hidden">
      View all services
      <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </Container>
</section>
