---
import { business } from '../../data/business';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
---

<section class="relative overflow-hidden bg-accent-600 py-12 sm:py-14">
  <div class="pointer-events-none absolute inset-0 opacity-10" aria-hidden="true">
    <svg width="100%" height="100%">
      <pattern id="emergency-dots" width="24" height="24" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1.5" fill="white" />
      </pattern>
      <rect width="100%" height="100%" fill="url(#emergency-dots)" />
    </svg>
  </div>
  <Container class="relative flex flex-col items-center gap-5 text-center sm:flex-row sm:justify-between sm:text-left">
    <div class="flex flex-col gap-1.5">
      <span class="text-xs font-bold uppercase tracking-widest text-white/80">24/7 Emergency Service</span>
      <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">
        Plumbing emergency? We&rsquo;re already on our way.
      </h2>
      <p class="max-w-lg text-sm text-white/85 sm:text-base">
        Burst pipe, no heat, sewer backup &mdash; Beacon dispatches around the clock, every day of the year.
      </p>
    </div>
    <Button href={business.phone.href} variant="secondary" size="lg" icon="phone" class="shrink-0 !bg-white !text-accent-600 hover:!bg-brand-50">
      Call {business.phone.display}
    </Button>
  </Container>
</section>
