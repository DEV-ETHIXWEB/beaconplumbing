---
import Container from '../ui/Container.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Icon3D, { type IconName } from '../ui/Icon3D.astro';
import type { BreadcrumbItem } from '../../lib/seo';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  breadcrumbs: BreadcrumbItem[];
  icon?: IconName;
  backgroundImage?: string;
}

const { eyebrow, title, description, breadcrumbs, icon, backgroundImage } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-950 py-12 sm:py-16">
  {backgroundImage ? (
    <>
      <img
        src={backgroundImage}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 h-full w-full object-cover object-[40%_10%]"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-brand-950 via-brand-950/80 to-brand-900/35" aria-hidden="true"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-brand-950/60 via-transparent to-brand-950/20" aria-hidden="true"></div>
    </>
  ) : (
    <div class="absolute inset-0 bg-gradient-to-br from-brand-900 via-brand-800 to-brand-950" aria-hidden="true"></div>
  )}
  <div class="pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true">
    <svg width="100%" height="100%">
      <pattern id="page-hero-grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M40 0H0V40" fill="none" stroke="white" stroke-width="1" />
      </pattern>
      <rect width="100%" height="100%" fill="url(#page-hero-grid)" />
    </svg>
  </div>
  <Container class="relative flex flex-col gap-4">
    <div class="[&_a]:text-brand-200 [&_a:hover]:text-white [&_span]:text-white [&_svg]:text-brand-300">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
      {icon && <Icon3D name={icon} class="h-20 w-auto shrink-0 sm:h-24" />}
      <div class="flex flex-col gap-2">
        {eyebrow && (
          <span class="text-xs font-semibold uppercase tracking-widest text-gold-500">{eyebrow}</span>
        )}
        <h1 class="max-w-2xl text-3xl font-extrabold text-white sm:text-4xl lg:text-5xl">{title}</h1>
        {description && <p class="max-w-2xl text-base text-brand-100 sm:text-lg">{description}</p>}
      </div>
    </div>
  </Container>
</section>
