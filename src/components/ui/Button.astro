---
type Variant = 'primary' | 'secondary' | 'outline' | 'ghost';
type Size = 'md' | 'lg';

interface Props {
  href?: string;
  variant?: Variant;
  size?: Size;
  class?: string;
  icon?: 'phone' | 'arrow' | 'none';
  type?: 'button' | 'submit';
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  icon = 'none',
  type = 'button',
} = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2 rounded-md font-display font-semibold transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 disabled:opacity-50 disabled:pointer-events-none';

const variants: Record<Variant, string> = {
  primary:
    // accent-600, not -500: white-on-accent-500 measures 4.35:1, just under
    // WCAG AA's 4.5:1 for normal-size text. accent-600 clears it (5.88:1)
    // while staying clearly the same brand red.
    'bg-accent-600 text-white shadow-sm hover:bg-accent-700 hover:shadow-md active:bg-accent-800',
  secondary:
    'bg-brand-500 text-white shadow-sm hover:bg-brand-600 hover:shadow-md active:bg-brand-700',
  outline:
    'border-2 border-brand-500 text-brand-600 hover:bg-brand-50 active:bg-brand-100',
  ghost: 'text-brand-600 hover:bg-brand-50 active:bg-brand-100',
};

const sizes: Record<Size, string> = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;

const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} type={!href ? type : undefined}>
  {icon === 'phone' && (
    <svg viewBox="0 0 20 20" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" clip-rule="evenodd" />
    </svg>
  )}
  <slot />
  {icon === 'arrow' && (
    <svg
      viewBox="0 0 20 20"
      class="h-4 w-4 shrink-0 transition-transform duration-200 group-hover:translate-x-1"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M4 10h12M11 5l5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
</Tag>
