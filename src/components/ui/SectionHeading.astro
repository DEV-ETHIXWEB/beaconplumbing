---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
  titleClass?: string;
}

const { eyebrow, title, description, align = 'left', class: className = '', titleClass = '' } = Astro.props;
const alignClass = align === 'center' ? 'text-center items-center mx-auto' : 'text-left items-start';
---

<div class={`flex max-w-2xl flex-col gap-3 ${alignClass} ${className}`}>
  {eyebrow && (
    <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-accent-600">
      <span class="h-px w-6 bg-accent-500" aria-hidden="true"></span>
      {eyebrow}
    </span>
  )}
  <h2 class={`text-3xl font-bold leading-tight text-ink-900 sm:text-4xl ${titleClass}`}>{title}</h2>
  {description && <p class="text-base leading-relaxed text-ink-500 sm:text-lg">{description}</p>}
</div>
