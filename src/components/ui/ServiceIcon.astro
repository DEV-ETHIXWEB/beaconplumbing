---
interface Props {
  icon: string;
  class?: string;
}

const { icon, class: className = 'h-8 w-8' } = Astro.props;
---

{icon === 'wrench' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M14.7 6.3a4 4 0 0 0-5.5 4.6L3 17.1V21h3.9l6.2-6.2a4 4 0 0 0 4.6-5.5l-2.8 2.8-2.1-2.1z" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{icon === 'pipe' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M4 8h9a3 3 0 0 1 3 3v0a3 3 0 0 0 3 3h1" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="4" cy="8" r="2" />
    <circle cx="20" cy="14" r="2" />
  </svg>
)}
{icon === 'flame' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M12 22c4 0 6.5-2.5 6.5-6 0-2.5-1.5-4-2.5-5.5.3 2-.8 3-1.8 3-1.5 0-1.7-1.5-1.5-3 .3-2.3-1-4-3-5.5-.5 2.5-1.7 4-3 5.5-1.6 1.9-2.7 3.5-2.7 5.5 0 3.5 2.5 6 8 6z" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{icon === 'snowflake' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M12 2v20M4.9 6l14.2 12M19.1 6 4.9 18M2 12h20M6 4.9 18 19.1M18 4.9 6 19.1" stroke-linecap="round" />
  </svg>
)}
{icon === 'bolt' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{icon === 'droplet' && (
  <svg viewBox="0 0 24 24" class={className} fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M12 2.5s6.5 7.2 6.5 11.8a6.5 6.5 0 1 1-13 0c0-4.6 6.5-11.8 6.5-11.8z" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
