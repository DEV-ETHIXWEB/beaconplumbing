---
import { Image } from 'astro:assets';
import { icons, type IconName } from '../../data/icon3d-assets';

export type { IconName };

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-16 w-16' } = Astro.props;
const icon = icons[name];
---

<Image src={icon} alt="" class={`${className} object-contain drop-shadow-sm`} />
