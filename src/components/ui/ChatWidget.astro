---
// Site-wide chat widget. Answers come from a static, local knowledge base
// (src/data/chatbot-knowledge.ts) built from the same real business data
// used elsewhere on the site — no LLM, no API key, no network call, so it
// works fully offline in the browser and never invents information.
import { business } from '../../data/business';

const quickReplies = ['Service areas', 'Emergency service', 'Financing', 'Book service'];
---

<div id="chat-widget" class="fixed bottom-[calc(5rem+env(safe-area-inset-bottom))] right-4 z-40 md:bottom-4">
  <button
    type="button"
    id="chat-toggle"
    aria-expanded="false"
    aria-controls="chat-panel"
    aria-label="Open chat assistant"
    class="relative flex h-14 w-14 items-center justify-center rounded-full bg-brand-900 text-white shadow-lg ring-4 ring-brand-300 transition-transform hover:scale-105 hover:bg-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
  >
    <svg data-icon="chat" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <path d="M4 5.5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H10.5l-4.3 3.4a.6.6 0 0 1-.97-.47V17.5H4a1 1 0 0 1-1-1v-10a1 1 0 0 1 1-1z" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <svg data-icon="close" viewBox="0 0 20 20" class="hidden h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M5 5l10 10M15 5L5 15" stroke-linecap="round" />
    </svg>
    <span class="absolute -right-0.5 -top-0.5 h-4 w-4 rounded-full border-2 border-white bg-emerald-500" aria-hidden="true"></span>
  </button>

  <div
    id="chat-panel"
    role="dialog"
    aria-label="Beacon Plumbing assistant"
    hidden
    class="absolute bottom-[4.5rem] right-0 flex h-[28rem] w-80 max-w-[calc(100vw-2rem)] flex-col overflow-hidden rounded-xl border border-ink-100 bg-white shadow-2xl"
  >
    <div class="flex items-center gap-3 bg-brand-600 px-4 py-3 text-white">
      <span class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-900 ring-2 ring-brand-300">
        <svg viewBox="0 0 24 24" class="h-4.5 w-4.5" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M4 5.5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H10.5l-4.3 3.4a.6.6 0 0 1-.97-.47V17.5H4a1 1 0 0 1-1-1v-10a1 1 0 0 1 1-1z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="absolute -right-0.5 -top-0.5 h-2.5 w-2.5 rounded-full border-2 border-white bg-emerald-500" aria-hidden="true"></span>
      </span>
      <div>
        <p class="font-display text-sm font-bold">Beacon Assistant</p>
        <p class="text-xs text-brand-100">Answers about our services &amp; areas</p>
      </div>
    </div>

    <div id="chat-messages" class="flex-1 space-y-3 overflow-y-auto px-4 py-3">
      <div class="flex flex-col gap-1.5">
        <div class="max-w-[85%] rounded-lg rounded-bl-sm bg-ink-100 px-3 py-2 text-sm text-ink-800">
          Hi! I'm the Beacon Plumbing assistant. Ask me about our services, service areas, financing, or how to
          reach us.
        </div>
      </div>
      <div id="chat-quick-replies" class="flex flex-wrap gap-2">
        {quickReplies.map((q) => (
          <button
            type="button"
            data-quick-reply={q}
            class="rounded-full border border-ink-200 px-3 py-1.5 text-xs font-medium text-ink-700 hover:border-brand-300 hover:bg-brand-50"
          >
            {q}
          </button>
        ))}
      </div>
    </div>

    <div class="border-t border-ink-100 p-3">
      <p class="mb-2 text-[11px] text-ink-400">
        Automated answers — for urgent issues call <a href={business.phone.href} class="font-semibold text-brand-600">{business.phone.display}</a>.
      </p>
      <form id="chat-form" class="flex gap-2">
        <label for="chat-input" class="sr-only">Ask a question</label>
        <input
          id="chat-input"
          type="text"
          autocomplete="off"
          placeholder="Ask a question…"
          class="flex-1 rounded-md border border-ink-200 px-3 py-2 text-sm text-ink-900 outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100"
        />
        <button
          type="submit"
          aria-label="Send"
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-brand-600 text-white hover:bg-brand-700"
        >
          <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M2.5 17.5l15-7.5-15-7.5v6l10 1.5-10 1.5z" />
          </svg>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  import { findAnswer } from '../../data/chatbot-knowledge';

  const widget = document.getElementById('chat-widget');
  const toggleBtn = document.getElementById('chat-toggle');
  const panel = document.getElementById('chat-panel');
  const messages = document.getElementById('chat-messages');
  const form = document.getElementById('chat-form') as HTMLFormElement | null;
  const input = document.getElementById('chat-input') as HTMLInputElement | null;
  const chatIcon = toggleBtn?.querySelector('[data-icon="chat"]');
  const closeIcon = toggleBtn?.querySelector('[data-icon="close"]');

  function setOpen(open: boolean) {
    toggleBtn?.setAttribute('aria-expanded', String(open));
    panel?.toggleAttribute('hidden', !open);
    chatIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    if (open) input?.focus();
  }

  toggleBtn?.addEventListener('click', () => {
    setOpen(toggleBtn.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('click', (e) => {
    // composedPath() reflects the DOM at dispatch time — unlike
    // widget.contains(e.target), it stays correct even when a handler for
    // this same click (e.g. the quick-reply buttons below) removes the
    // clicked element from the DOM before this listener runs.
    if (widget && !e.composedPath().includes(widget)) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  function addMessage(text: string, from: 'user' | 'bot', link?: { label: string; href: string }) {
    if (!messages) return;
    const row = document.createElement('div');
    row.className = 'flex flex-col gap-1.5' + (from === 'user' ? ' items-end' : '');

    const bubble = document.createElement('div');
    bubble.className =
      from === 'user'
        ? 'max-w-[85%] rounded-lg rounded-br-sm bg-brand-600 px-3 py-2 text-sm text-white'
        : 'max-w-[85%] rounded-lg rounded-bl-sm bg-ink-100 px-3 py-2 text-sm text-ink-800';
    bubble.textContent = text;
    row.appendChild(bubble);

    if (link) {
      const a = document.createElement('a');
      a.href = link.href;
      a.textContent = link.label + ' →';
      a.className = 'ml-1 text-xs font-semibold text-brand-600 hover:text-brand-700 hover:underline';
      row.appendChild(a);
    }

    messages.appendChild(row);
    messages.scrollTop = messages.scrollHeight;
  }

  function ask(text: string) {
    const trimmed = text.trim();
    if (!trimmed) return;
    addMessage(trimmed, 'user');
    document.getElementById('chat-quick-replies')?.remove();
    const result = findAnswer(trimmed);
    // Tiny delay so the bot reply doesn't render in the exact same tick as
    // the user's message — reads more like a real reply, not an echo.
    window.setTimeout(() => addMessage(result.answer, 'bot', result.link), 250);
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!input) return;
    ask(input.value);
    input.value = '';
  });

  document.querySelectorAll<HTMLButtonElement>('[data-quick-reply]').forEach((btn) => {
    btn.addEventListener('click', () => ask(btn.dataset.quickReply || ''));
  });
</script>
