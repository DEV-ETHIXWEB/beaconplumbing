---
import { business } from '../../data/business';
import { mainNav } from '../../data/navigation';
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
import MobileNav from './MobileNav';
---

<header id="site-header" class="sticky top-0 z-50 border-b border-ink-100 bg-white/95 backdrop-blur supports-backdrop-filter:bg-white/80">
  <div class="site-header__utility hidden bg-brand-900 text-white xl:block">
    <Container class="flex items-center justify-between py-1.5 text-xs">
      <p class="font-medium tracking-wide">
        24/7 Emergency Service &middot; Licensed, Bonded &amp; Insured &middot; Serving Puget Sound Since {business.foundingYear}
      </p>
      <a href={business.phone.href} class="font-semibold text-gold-500 hover:text-gold-400">
        {business.phone.display}
      </a>
    </Container>
  </div>

  <Container class="site-header__main flex min-w-0 items-center justify-between gap-3 py-3">
    <a href="/" class="flex h-[3.3rem] shrink-0 items-center sm:h-[3.6rem]" aria-label={`${business.name} home`}>
      <Logo variant="light" />
    </a>

    <nav class="hidden min-w-0 items-center xl:flex" aria-label="Primary">
      {mainNav.map((item) => (
        <div class="group relative">
          <a
            href={item.href}
            class="flex items-center gap-1 whitespace-nowrap rounded-md px-2 py-2 text-sm font-semibold text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-600"
          >
            {item.label}
            {item.children && (
              <svg viewBox="0 0 20 20" class="h-3.5 w-3.5 text-ink-400" fill="currentColor" aria-hidden="true">
                <path d="M5.5 7.5l4.5 4.5 4.5-4.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </a>
          {item.children && (
            <div class="invisible absolute left-0 top-full z-20 w-64 translate-y-1 rounded-lg border border-ink-100 bg-white p-2 opacity-0 shadow-lg transition-all duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="block rounded-md px-3 py-2 text-sm font-medium text-ink-600 transition-colors hover:bg-brand-50 hover:text-brand-600"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <a
        href={business.phone.href}
        aria-label={`Call ${business.phone.display}`}
        class="hidden items-center gap-3 whitespace-nowrap rounded-full bg-accent-600 py-2 pl-2 pr-5 text-white shadow-md transition-all hover:bg-accent-700 hover:shadow-lg active:bg-accent-800 sm:flex"
      >
        <span class="relative flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white/15">
          <span class="absolute inset-0 rounded-full bg-white/30 motion-safe:animate-ping" aria-hidden="true"></span>
          <svg viewBox="0 0 20 20" class="relative h-5 w-5 text-white" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" clip-rule="evenodd" />
          </svg>
        </span>
        <span class="flex flex-col leading-tight">
          <span class="text-[0.65rem] font-bold uppercase tracking-wide text-white/85">Call Now</span>
          <span class="font-display text-lg font-extrabold tracking-tight lg:text-xl">
            {business.phone.display}
          </span>
        </span>
      </a>
      <MobileNav client:load business={business} mainNav={mainNav} />
    </div>
  </Container>
</header>

<style>
  .site-header__utility {
    overflow: hidden;
    max-height: 2.5rem;
    opacity: 1;
    transition: max-height 300ms ease, opacity 200ms ease, padding-block 300ms ease;
  }

  .site-header__main {
    transition: padding-block 300ms ease;
  }

  header.is-scrolled .site-header__utility {
    max-height: 0;
    opacity: 0;
  }

  header.is-scrolled .site-header__main {
    padding-block: 0.625rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__utility,
    .site-header__main {
      transition: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    let ticking = false;
    const updateState = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 24);
      ticking = false;
    };
    updateState();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(updateState);
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>
