---
import { business } from '../../data/business';
---

<div class="fixed inset-x-0 bottom-0 z-40 flex border-t border-ink-200 bg-white shadow-[0_-2px_12px_rgba(0,0,0,0.08)] md:hidden [padding-bottom:env(safe-area-inset-bottom)]">
  <a
    href={business.phone.href}
    class="flex flex-1 flex-col items-center justify-center gap-0.5 border-r border-ink-100 py-2.5 text-accent-600 active:bg-accent-50"
  >
    <svg viewBox="0 0 20 20" class="h-5 w-5" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" clip-rule="evenodd" />
    </svg>
    <span class="text-[11px] font-semibold">Call</span>
  </a>
  <a
    href="/contact"
    class="flex flex-1 flex-col items-center justify-center gap-0.5 border-r border-ink-100 py-2.5 text-brand-600 active:bg-brand-50"
  >
    <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M4 5h12a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H8l-3 3v-3H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="text-[11px] font-semibold">Book</span>
  </a>
  <a
    href="/emergency-plumbing"
    class="flex flex-1 flex-col items-center justify-center gap-0.5 py-2.5 text-ink-600 active:bg-ink-50"
  >
    <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M10 2l6.5 11.5H3.5L10 2z" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M10 8v3.5M10 14.2v.1" stroke-linecap="round" />
    </svg>
    <span class="text-[11px] font-semibold">Emergency</span>
  </a>
</div>
