# Copy to .env and fill in real values. Never commit .env itself (already
# in .gitignore).

# URL the contact form (src/components/forms/ContactForm.tsx) POSTs to as
# JSON — a serverless function, Formspree endpoint, or whatever CRM/email
# integration Beacon actually uses. PUBLIC_ prefix is required for Astro to
# expose it to client-side code; this is a destination URL, not a secret.
#
# If unset, the form still works safely: it shows an honest "not connected
# yet" error on submit instead of a fake success — it never silently
# pretends to have delivered a lead it didn't.
PUBLIC_CONTACT_FORM_ENDPOINT=
